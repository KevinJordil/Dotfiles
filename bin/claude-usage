#!/usr/bin/env bash
# Pour la barre d'onglets de l'app Herdr (mod kevin-tabs) : compte et organisation Claude en cours, et où en sont
# ses limites (session de 5 h, semaine), comme /usage dans Claude Code. Jeton OAuth de Claude Code, envoyé
# à l'API Anthropic seulement, par un descripteur plutôt qu'en argument (visible dans ps).
# L'API refuse les appels trop rapprochés (429) : un appel toutes les 5 min au plus, sinon la dernière réponse.
# Une réponse par organisation : après un changement (claude auth login), pas d'anciennes valeurs.
C=~/.cache/herdr-agents/usage-$(jq -r .oauthAccount.organizationUuid ~/.claude.json).json
if [[ ! -e $C || $(find "$C" -mmin +5) ]]; then
  u=$(curl -sf -m 10 https://api.anthropic.com/api/oauth/usage -H "anthropic-beta: oauth-2025-04-20" \
    -H @<(printf 'Authorization: Bearer %s\n' "$(jq -r .claudeAiOauth.accessToken ~/.claude/.credentials.json)")) &&
    echo "$u" >"$C" || touch "$C"
fi
u=$(cat "$C" 2>/dev/null); [[ $u ]] || u=null
# autres organisations, choisies au lancement de claude (bin/claude-org)
others=$(ls ~/.config/claude-orgs 2>/dev/null | sed -n 's/\.token$//p' | jq -R . | jq -s .)
jq -n --argjson u "$u" --argjson others "$others" --slurpfile c ~/.claude.json --slurpfile k ~/.claude/.credentials.json '{
  name: $c[0].oauthAccount.fullName, email: $c[0].oauthAccount.emailAddress, org: $c[0].oauthAccount.organizationName,
  plan: $k[0].claudeAiOauth.subscriptionType, session: $u.five_hour, weekly: $u.seven_day, others: $others}'
