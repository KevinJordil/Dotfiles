#!/usr/bin/env python3
# Touche ² : amène l'app Herdr devant, sur l'écran de la souris ; si elle y est déjà au premier plan, la réduit.
# Fenêtre normale et agrandie : la barre du haut et le dock restent visibles.
# Le placement passe par l'extension GNOME console@dotfiles.ch (D-Bus, ToggleApp) : en Wayland, seul le Shell
# peut déplacer ou activer la fenêtre d'un autre client. L'extension est écrite pour GNOME 42-44 ; ailleurs
# (GNOME 46 de l'Ubuntu 24.04), en X11, Wnck fait le même travail.
import os, subprocess, sys, time, gi
from gi.repository import Gio, GLib

CLASS = 'herdr-app'
APP = os.path.expanduser('~/.local/bin/herdr-app')

def launch():
    # Une session Wayland ne lit pas ~/.profile : on remet ~/.local/bin dans le PATH pour l'app et ses terminaux.
    env = dict(os.environ)
    env['PATH'] = os.path.dirname(APP) + os.pathsep + env.get('PATH', '')
    subprocess.Popen([APP], env=env, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def via_extension():
    return Gio.bus_get_sync(Gio.BusType.SESSION, None).call_sync(
        'ch.dotfiles.Console', '/ch/dotfiles/Console', 'ch.dotfiles.Console', 'ToggleApp',
        GLib.Variant('(s)', (CLASS,)), GLib.VariantType('(b)'), Gio.DBusCallFlags.NONE, 3000, None).unpack()[0]

def via_wnck():
    gi.require_version('Gdk', '3.0'); gi.require_version('GdkX11', '3.0'); gi.require_version('Wnck', '3.0')
    from gi.repository import Gdk, GdkX11, Wnck
    screen = Wnck.Screen.get_default()

    def find():
        while GLib.MainContext.default().iteration(False):  # sans boucle d'événements, Wnck ne voit pas les nouvelles fenêtres
            pass
        screen.force_update()
        return next((w for w in screen.get_windows() if w.get_class_group_name() == CLASS), None)

    def pointer_monitor():  # sa zone de travail : l'écran sans la barre du haut ni le dock
        display = Gdk.Display.get_default()
        _, x, y = display.get_default_seat().get_pointer().get_position()
        return display.get_monitor_at_point(x, y).get_workarea()

    def on_monitor(win, m):
        x, y, w, h = win.get_geometry()
        return m.x <= x + w // 2 < m.x + m.width and m.y <= y + h // 2 < m.y + m.height

    def show(win):
        ws = screen.get_active_workspace()
        if ws and not win.is_on_workspace(ws):
            win.move_to_workspace(ws)
        if win.is_fullscreen():
            win.set_fullscreen(False)  # sans bordure et à la taille de l'écran, GNOME la passe en plein écran
            time.sleep(0.1)
        m = pointer_monitor()
        if not on_monitor(win, m):
            if win.is_maximized():
                win.unmaximize()  # une fenêtre agrandie reste collée à son écran : on la libère pour la déplacer
                time.sleep(0.1)
            geo = Wnck.WindowMoveResizeMask
            win.set_geometry(Wnck.WindowGravity.STATIC, geo.X | geo.Y | geo.WIDTH | geo.HEIGHT, m.x, m.y, m.width, m.height)
            time.sleep(0.1)
            win.maximize()
        win.activate(GdkX11.x11_get_server_time(Gdk.get_default_root_window()))

    win = find()
    if win is None:
        launch()
        for _ in range(100):  # 10 s max : l'app peut démarrer herdr-core
            time.sleep(0.1)
            if win := find():
                show(win)
                break
    elif win.is_active() and on_monitor(win, pointer_monitor()):  # au premier plan ici : on la réduit ; ailleurs, show() la déplace
        win.minimize()
    else:
        show(win)

try:
    if not via_extension():
        launch()  # l'extension placera la fenêtre dès qu'elle apparaît
except GLib.Error as e:
    if os.environ.get('XDG_SESSION_TYPE', 'x11') == 'x11':
        via_wnck()
    else:
        # Lancée par un raccourci GNOME, la sortie d'erreur n'est lue par personne : on la rend visible.
        msg = (f"Extension GNOME console@dotfiles.ch injoignable : {e.message}. "
               "Vérifie « gnome-extensions info console@dotfiles.ch », puis déconnecte-toi/reconnecte-toi "
               "(en Wayland le Shell ne charge une nouvelle extension qu'au démarrage de la session).")
        subprocess.run(['notify-send', '-u', 'critical', 'App Herdr', msg], check=False)
        sys.exit(msg)
