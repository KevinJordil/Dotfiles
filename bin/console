#!/usr/bin/env python3
# Touche console : affiche/masque la fenêtre Ghostty qui héberge herdr, comme `guake -t`.
# Le placement (écran de la souris, plein écran, tous les bureaux, au-dessus) est fait par
# l'extension GNOME console@dotfiles.ch : en Wayland, un client ne peut ni déplacer ni activer
# la fenêtre d'un autre client. Le même chemin sert en X11, donc plus de Wnck ni de Xlib.
# Lancée par un raccourci GNOME (mode console) ou par console.desktop (mode fenêtre).
# `console --window` : même session herdr dans une fenêtre normale (dock, bordure, agrandie).
import os, shutil, subprocess, sys
import gi
from gi.repository import Gio, GLib

WINDOW = '--window' in sys.argv
# app id GTK : doit avoir la forme d'un nom de domaine inversé
CLASS = 'ch.dotfiles.window' if WINDOW else 'ch.dotfiles.console'

# Une session Wayland ne lit pas ~/.profile : rien lancé depuis un raccourci GNOME ou le dock
# n'hérite de ~/.local/bin, où vit herdr. Ghostty échouerait à l'exécuter et la fenêtre serait vide.
# On répare le PATH ici, et herdr comme les shells de ses panes en héritent.
env = dict(os.environ)
local_bin = os.path.expanduser('~/.local/bin')
if local_bin not in env.get('PATH', '').split(os.pathsep):
    env['PATH'] = local_bin + os.pathsep + env.get('PATH', '')
HERDR = shutil.which('herdr', path=env['PATH']) or 'herdr'

cmd = ['ghostty', f'--class={CLASS}', '--gtk-single-instance=false']
if WINDOW:  # agrandie, pas plein écran : barre du haut et dock visibles
    cmd += ['--maximize=true', '--window-decoration=server', '--gtk-titlebar=false']
else:
    cmd += ['--fullscreen=true']  # l'extension s'en charge aussi : évite une fenêtre qui saute
cmd += ['-e', HERDR]

try:
    found = Gio.bus_get_sync(Gio.BusType.SESSION, None).call_sync(
        'ch.dotfiles.Console', '/ch/dotfiles/Console', 'ch.dotfiles.Console', 'Toggle',
        GLib.Variant('(sb)', (CLASS, not WINDOW)), GLib.VariantType('(b)'),
        Gio.DBusCallFlags.NONE, 3000, None).unpack()[0]
except GLib.Error as e:
    # Lancée par un raccourci GNOME, la sortie d'erreur n'est lue par personne : on la rend visible.
    msg = (f"Extension GNOME console@dotfiles.ch injoignable : {e.message}. "
           "Vérifie « gnome-extensions info console@dotfiles.ch », puis déconnecte-toi/reconnecte-toi "
           "(en Wayland le Shell ne charge une nouvelle extension qu'au démarrage de la session).")
    subprocess.run(['notify-send', '-u', 'critical', 'Console herdr', msg], check=False)
    sys.exit(msg)

if not found:  # l'extension placera la fenêtre dès qu'elle apparaît
    subprocess.Popen(cmd, env=env, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
