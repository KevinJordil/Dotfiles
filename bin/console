#!/usr/bin/env python3
# Touche ² : amène l'app Herdr devant, sur l'écran de la souris ; si elle y est déjà au premier plan, la réduit.
# Fenêtre normale et agrandie : la barre du haut et le dock restent visibles.
# Lancée par un raccourci GNOME. Wnck (X11) suffit : pas besoin de xdotool.
import os, subprocess, time, gi
gi.require_version('Gdk', '3.0'); gi.require_version('GdkX11', '3.0'); gi.require_version('Wnck', '3.0')
from gi.repository import Gdk, GdkX11, Wnck

CLASS = 'herdr-app'
screen = Wnck.Screen.get_default()

def find():
    screen.force_update()
    return next((w for w in screen.get_windows() if w.get_class_group_name() == CLASS), None)

def pointer_monitor():  # sa zone de travail : l'écran sans la barre du haut ni le dock
    display = Gdk.Display.get_default()
    _, x, y = display.get_default_seat().get_pointer().get_position()
    return display.get_monitor_at_point(x, y).get_workarea()

def on_monitor(win, m):
    x, y, w, h = win.get_geometry()
    return m.x <= x + w // 2 < m.x + m.width and m.y <= y + h // 2 < m.y + m.height

def show(win):
    ws = screen.get_active_workspace()
    if ws and not win.is_on_workspace(ws):
        win.move_to_workspace(ws)
    if win.is_fullscreen():
        win.set_fullscreen(False)  # sans bordure et à la taille de l'écran, GNOME la passe en plein écran
        time.sleep(0.1)
    m = pointer_monitor()
    if not on_monitor(win, m):
        if win.is_maximized():
            win.unmaximize()  # une fenêtre agrandie reste collée à son écran : on la libère pour la déplacer
            time.sleep(0.1)
        geo = Wnck.WindowMoveResizeMask
        win.set_geometry(Wnck.WindowGravity.STATIC, geo.X | geo.Y | geo.WIDTH | geo.HEIGHT, m.x, m.y, m.width, m.height)
        time.sleep(0.1)
        win.maximize()
    win.activate(GdkX11.x11_get_server_time(Gdk.get_default_root_window()))

win = find()
if win is None:
    subprocess.Popen([os.path.expanduser('~/.local/bin/herdr-app')], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(100):  # 10 s max : l'app peut démarrer herdr-core
        time.sleep(0.1)
        if win := find():
            show(win)
            break
elif win.is_active() and on_monitor(win, pointer_monitor()):  # au premier plan ici : on la réduit ; sur un autre écran, show() la déplace
    win.minimize()
else:
    show(win)
