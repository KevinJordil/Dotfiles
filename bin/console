#!/usr/bin/env python3
# Touche console : affiche/masque la fenêtre Ghostty qui héberge herdr, comme `guake -t`.
# Lancée par un raccourci GNOME. Wnck (X11) suffit : pas besoin de xdotool.
import subprocess, time, gi
gi.require_version('Gdk', '3.0'); gi.require_version('GdkX11', '3.0'); gi.require_version('Wnck', '3.0')
from gi.repository import Gdk, GdkX11, Wnck

CLASS = 'ch.dotfiles.console'  # app id GTK : doit avoir la forme d'un nom de domaine inversé
screen = Wnck.Screen.get_default()

def find():
    screen.force_update()
    return next((w for w in screen.get_windows() if w.get_class_group_name() == CLASS), None)

def pointer_monitor():
    display = Gdk.Display.get_default()
    _, x, y = display.get_default_seat().get_pointer().get_position()
    return display.get_monitor_at_point(x, y).get_geometry()

def show(win):
    ws = screen.get_active_workspace()
    if ws and not win.is_on_workspace(ws):
        win.move_to_workspace(ws)
    m = pointer_monitor()  # comme Guake : s'ouvre sur l'écran de la souris
    x, y, w, h = win.get_geometry()
    if not (m.x <= x + w // 2 < m.x + m.width and m.y <= y + h // 2 < m.y + m.height):
        if win.is_fullscreen():
            win.set_fullscreen(False)  # le plein écran reste collé à son écran : on le quitte pour déplacer
            time.sleep(0.1)
        geo = Wnck.WindowMoveResizeMask
        win.set_geometry(Wnck.WindowGravity.STATIC, geo.X | geo.Y | geo.WIDTH | geo.HEIGHT,
                         m.x, m.y, m.width, m.height)
        time.sleep(0.1)
    win.set_skip_tasklist(True)  # comme Guake : ni dans la barre des tâches, ni dans Alt+Tab
    win.set_skip_pager(True)
    if not win.is_fullscreen():
        win.set_fullscreen(True)  # Ghostty ignore `fullscreen = true` sous GNOME/X11
    win.activate(GdkX11.x11_get_server_time(Gdk.get_default_root_window()))

win = find()
if win is None:
    subprocess.Popen(['ghostty', f'--class={CLASS}', '--gtk-single-instance=false', '-e', 'herdr'],
                     start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(50):  # attend la fenêtre puis son plein écran (5 s max) : trop tôt, la demande est ignorée
        time.sleep(0.1)
        if (win := find()) and not win.is_fullscreen():
            show(win)
        elif win:
            break
elif win.is_active():
    # GNOME interdit de réduire une fenêtre hors barre des tâches : on lève l'option le temps de réduire
    win.set_skip_tasklist(False)
    time.sleep(0.05)
    win.minimize()
    time.sleep(0.1)
    win.set_skip_tasklist(True)
else:
    show(win)
