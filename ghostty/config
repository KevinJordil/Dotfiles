# Ghostty : fenêtre de la console herdr (affichée/masquée par bin/console). Assorti au thème herdr.dev.
theme = Catppuccin Mocha
background = #11111b
font-family = Roboto Mono
font-size = 11
window-decoration = false
confirm-close-surface = false
# Onglets, fenêtres et splits : gérés par herdr. Ceux de Ghostty sont désactivés (les touches passent à herdr)
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
