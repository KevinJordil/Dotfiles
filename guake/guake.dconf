[general]
compat-delete='delete-sequence'
display-n=0
display-tab-names=0
fullscreen-hide-tabbar=false
gtk-prefer-dark-theme=false
gtk-theme-name='Yaru-dark'
gtk-use-system-default-theme=true
hide-tabs-if-one-tab=true
history-size=10000
load-guake-yml=true
max-tab-name-length=100
mouse-display=true
new-tab-after=false
open-tab-cwd=true
prompt-on-close-tab=2
prompt-on-quit=true
quick-open-command-line='gedit %(file_path)s'
quick-open-enable=false
restore-tabs-notify=false
restore-tabs-startup=false
save-tabs-when-changed=false
scroll-keystroke=true
start-at-login=true
start-fullscreen=true
tab-close-buttons=false
use-default-font=false
use-popup=true
use-scrollbar=false
use-trayicon=true
window-halignment=0
window-height=100
window-losefocus=false
window-refocus=false
window-tabbar=true
window-width=100

[keybindings/global]
show-hide='F12'

[keybindings/local]
switch-tab1='disabled'
switch-tab2='disabled'
switch-tab3='disabled'
switch-tab4='disabled'
switch-tab5='disabled'
switch-tab6='disabled'
switch-tab7='disabled'
switch-tab8='disabled'
switch-tab9='disabled'
zoom-in='<Primary>KP_Add'
zoom-out='<Primary>KP_Subtract'

[style/background]
transparency=100

[style/font]
allow-bold=true
palette='#454547475a5a:#f3f38b8ba8a8:#a6a6e3e3a1a1:#f9f9e2e2afaf:#8989b4b4fafa:#f5f5c2c2e7e7:#9494e2e2d5d5:#babac2c2dede:#58585b5b7070:#f3f38b8ba8a8:#a6a6e3e3a1a1:#f9f9e2e2afaf:#8989b4b4fafa:#f5f5c2c2e7e7:#9494e2e2d5d5:#a6a6adadc8c8:#cdcdd6d6f4f4:#111111111b1b'
palette-name='Catppuccin Mocha'
style='Roboto Mono 11'
