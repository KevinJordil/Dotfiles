[general]
compat-delete='delete-sequence'
display-n=0
display-tab-names=0
fullscreen-hide-tabbar=false
gtk-prefer-dark-theme=false
gtk-theme-name='Yaru-dark'
gtk-use-system-default-theme=true
hide-tabs-if-one-tab=false
history-size=10000
load-guake-yml=true
max-tab-name-length=100
mouse-display=true
new-tab-after=false
open-tab-cwd=true
prompt-on-close-tab=2
prompt-on-quit=true
quick-open-command-line='gedit %(file_path)s'
quick-open-enable=false
restore-tabs-notify=true
restore-tabs-startup=true
save-tabs-when-changed=true
scroll-keystroke=true
start-at-login=true
start-fullscreen=true
tab-close-buttons=false
use-default-font=false
use-popup=true
use-scrollbar=true
use-trayicon=true
window-halignment=0
window-height=28
window-losefocus=false
window-refocus=false
window-tabbar=true
window-width=100

[keybindings/global]
show-hide='section'

[keybindings/local]
zoom-in='<Primary>KP_Add'
zoom-out='<Primary>KP_Subtract'

[style/background]
transparency=91

[style/font]
allow-bold=true
palette='#000000000000:#d6d686868686:#aeaed6d68686:#d7d7afaf8787:#8686aeaed6d6:#d6d6aeaed6d6:#8a8adbdbb4b4:#d0d0d0d0d0d0:#1c1c1c1c1c1c:#d6d686868686:#aeaed6d68686:#e4e4c9c9afaf:#8686aeaed6d6:#d6d6aeaed6d6:#b1b1e7e7dddd:#efefefefefef:#dededddddada:#262626262626'
palette-name='Custom'
style='Roboto Mono 11'
