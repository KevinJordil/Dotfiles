# Guake → herdr : doit rester en tête (exec herdr avant tout le reste)
source ~/dotfiles/zsh/herdr.zsh

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # prompt : Starship (en fin de fichier)
plugins=(git zsh-autosuggestions docker)
source $ZSH/oh-my-zsh.sh

export PATH=$HOME/.local/bin:$PATH

# Réglages propres à ce PC (variables, alias, fonctions pro) : hors repo
[[ ! -f ~/.zshrc.local ]] || source ~/.zshrc.local

# Prompt Starship : config dans ~/dotfiles/zsh/starship.toml
export STARSHIP_CONFIG=~/dotfiles/zsh/starship.toml
eval "$(starship init zsh)"
