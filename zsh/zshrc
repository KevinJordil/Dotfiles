# Guake + tmux : doit rester en tête (exec tmux avant tout le reste)
source ~/dotfiles/zsh/guake-tmux.zsh

# Powerlevel10k instant prompt : rester près du haut ; ce qui demande une saisie doit être au-dessus.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git zsh-autosuggestions docker)
source $ZSH/oh-my-zsh.sh

# Config du prompt : `p10k configure` ou éditer ~/.p10k.zsh
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
export PATH=$HOME/.local/bin:$PATH

# Réglages propres à ce PC (variables, alias, fonctions pro) : hors repo
[[ ! -f ~/.zshrc.local ]] || source ~/.zshrc.local
